<UserControl x:Class="FocusFlow.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="920">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Lifetime Metrics -->
            <UniformGrid Columns="3" Margin="0,0,0,24">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL FOCUS MINUTES" Style="{StaticResource SubText}"/>
                        <TextBlock Text="{Binding TotalFocusMinutes}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL POMODOROS" Style="{StaticResource SubText}"/>
                        <TextBlock Text="{Binding TotalPomodoros}" FontSize="32" FontWeight="Bold" Foreground="#EC4899" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="COMPLETED TASKS" Style="{StaticResource SubText}"/>
                        <TextBlock Text="{Binding TotalCompletedTasks}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Past 7 Days Focus Distribution Bar Chart -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Text="Weekly Focus Time (Past 7 Days)" Style="{StaticResource Heading2}" Margin="0,0,0,20"/>

                    <ItemsControl ItemsSource="{Binding WeeklyStats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Height="180"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Bottom" Margin="12,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Focus Mins label -->
                                    <TextBlock Grid.Row="0" Text="{Binding FocusMinutes, StringFormat='{}{0}m'}" 
                                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" 
                                               HorizontalAlignment="Center" Margin="0,0,0,6"/>

                                    <!-- Graphical Bar -->
                                    <Border Grid.Row="1" Background="{StaticResource PrimaryAccentBrush}" CornerRadius="6" VerticalAlignment="Bottom" Height="100">
                                        <Border.LayoutTransform>
                                            <ScaleTransform ScaleY="{Binding HeightRatio}"/>
                                        </Border.LayoutTransform>
                                    </Border>

                                    <!-- Day Label -->
                                    <TextBlock Grid.Row="2" Text="{Binding DayLabel}" FontSize="12" FontWeight="Bold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Project Breakdown -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                <StackPanel>
                    <TextBlock Text="Focus Distribution by Project" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding ProjectStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding ColorHex}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding ProjectName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <ProgressBar Grid.Column="1" Value="{Binding TotalMinutes}" Maximum="300" Height="8" Foreground="{StaticResource PrimaryAccentBrush}" Background="#0F172A" VerticalAlignment="Center" Margin="12,0"/>

                                        <TextBlock Grid.Column="2" Text="{Binding TotalMinutes, StringFormat='{}{0} mins'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
