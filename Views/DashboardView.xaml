<UserControl x:Class="FocusFlow.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="920">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Column: Today's Tasks Workspace -->
            <ColumnDefinition Width="*"/>
            <!-- Right Column: Integrated Focus Timer Widget -->
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Today's Tasks Section -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <!-- Today Header & Actions -->
                <RowDefinition Height="Auto"/>
                <!-- Today Tasks Scrollable List -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Today Header & Actions Bar -->
            <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="20,16" Margin="0,0,0,16">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding TodayDateFormatted}" FontSize="13" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="Today's Tasks" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right" Content="+ New Task" Style="{DynamicResource PrimaryButtonStyle}" 
                            Command="{Binding CreateTaskCommand}" Padding="18,10" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Today Tasks List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding TodayTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardSubBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Completion Checkbox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}" 
                                                  Command="{Binding DataContext.ToggleTaskCompletionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                  CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <!-- Task Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="{Binding ProjectColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding ProjectName}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding DueDateDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Priority}" FontSize="11" Foreground="{Binding PriorityColor}" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Pomodoro Count Badge -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                            <TextBlock Text="🍅 " FontSize="12"/>
                                            <TextBlock Text="{Binding CompletedPomodoros}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="/" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding EstimatedPomodoros}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>

                                        <!-- Focus Launch Button -->
                                        <Button Grid.Column="3" Content="Focus" Style="{DynamicResource SecondaryButtonStyle}" 
                                                Command="{Binding DataContext.StartTaskFocusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Padding="12,6" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Right Column: Integrated Focus Timer Widget -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{DynamicResource CardBorderStyle}" Padding="24">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="FOCUS TIMER" Style="{DynamicResource SubText}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Session Mode Badge -->
                    <Border Background="{DynamicResource PrimaryAccentBrush}" CornerRadius="12" Padding="14,4" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="{Binding PomodoroViewModel.TimerService.CurrentSessionType}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Selected Target Task Title -->
                    <TextBlock Text="{Binding PomodoroViewModel.ActiveTaskTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,20"/>

                    <!-- Circular Countdown Display -->
                    <Grid Width="210" Height="210" Margin="0,0,0,24">
                        <Ellipse Stroke="{DynamicResource CardSubBgBrush}" StrokeThickness="14"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PomodoroViewModel.TimerService.TimeRemainingFormatted}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding PomodoroViewModel.TimerService.State}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Control Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="▶ START" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding PomodoroViewModel.StartCommand}" Padding="16,8" FontSize="13" Margin="0,0,6,0"/>
                        <Button Content="⏸ PAUSE" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding PomodoroViewModel.PauseCommand}" Padding="14,8" FontSize="13" Margin="0,0,6,0"/>
                        <Button Content="🔄 RESET" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding PomodoroViewModel.ResetCommand}" Padding="14,8" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
