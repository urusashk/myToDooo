<UserControl x:Class="FocusFlow.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="920">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Date & Banner Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding TodayDateFormatted}" FontSize="14" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Welcome Back! Ready to Focus?" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="⚡ Start Focus Session" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartFocusCommand}" Padding="20,12"/>
            </Grid>

            <!-- Quick Add Task Bar -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding QuickTaskTitle, UpdateSourceTrigger=PropertyChanged}" 
                             ToolTip="Type a task title and press Add..." 
                             Margin="0,0,12,0" Height="36" VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding QuickTaskProject}" 
                              DisplayMemberPath="Name" Margin="0,0,12,0" Height="36" VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="2" ItemsSource="{Binding Priorities}" SelectedItem="{Binding QuickTaskPriority}" 
                              Margin="0,0,12,0" Height="36" VerticalAlignment="Center"/>

                    <Button Grid.Column="3" Content="+ Add Task" Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding QuickAddTaskCommand}" Height="36" VerticalAlignment="Center" Padding="16,0"/>
                </Grid>
            </Border>

            <!-- Metrics Summary Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <!-- Today's Tasks -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="COMPLETED TASKS TODAY" Style="{StaticResource SubText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding CompletedTasksToday}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text=" tasks" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Remaining Tasks -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="REMAINING TASKS TODAY" Style="{StaticResource SubText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding RemainingTasksToday}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text=" pending" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Focus Time Today -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="FOCUS TIME TODAY" Style="{StaticResource SubText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding TodayFocusMinutes}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <TextBlock Text=" mins" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Pomodoros Completed -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="POMODOROS TODAY" Style="{StaticResource SubText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding TodayPomodoros}" FontSize="28" FontWeight="Bold" Foreground="#EC4899"/>
                            <TextBlock Text=" sessions" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Main Dashboard Columns -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Today's Tasks List -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,16">
                            <TextBlock Text="Today's Target Tasks" Style="{StaticResource Heading2}" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding TodayTasks.Count, StringFormat='{}{0} Total'}" Style="{StaticResource SubText}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding TodayTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox toggle -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}" 
                                                      Command="{Binding DataContext.ToggleTaskCompletionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                      CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <!-- Task Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Border Background="{Binding ProjectColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding ProjectName}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DueDateDisplay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Pomodoro Count Badge -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock Text="🍅 " FontSize="12"/>
                                                <TextBlock Text="{Binding CompletedPomodoros}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding EstimatedPomodoros}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>

                                            <!-- Focus Launch Button -->
                                            <Button Grid.Column="3" Content="Focus" Style="{StaticResource SecondaryButtonStyle}" 
                                                    Command="{Binding DataContext.StartTaskFocusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Padding="10,4" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Sidebar: Overdue Alerts & Upcoming Activity -->
                <StackPanel Grid.Column="1">
                    <!-- Overdue Tasks Banner -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock Text="⚠️ Overdue Tasks" Style="{StaticResource Heading2}" Foreground="{StaticResource DangerBrush}" DockPanel.Dock="Left"/>
                                <Border Background="{StaticResource DangerBrush}" CornerRadius="10" Padding="8,2" DockPanel.Dock="Right">
                                    <TextBlock Text="{Binding OverdueTasks.Count}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding OverdueTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding DueDateDisplay, StringFormat='Due: {0}'}" FontSize="11" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Upcoming Reminders -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Upcoming Reminders" Style="{StaticResource Heading2}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding UpcomingTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding DueDateDisplay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
