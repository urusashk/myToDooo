<UserControl x:Class="FocusFlow.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="920">

    <Grid>
        <Grid.RowDefinitions>
            <!-- View Tabs Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Task List -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Tabs Bar (All / Today / Upcoming / Completed) -->
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="8" Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="📋 All Tasks" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding SelectTabCommand}" CommandParameter="All" Margin="0,0,4,0"/>
                    <Button Content="⭐ Today" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding SelectTabCommand}" CommandParameter="Today" Margin="0,0,4,0"/>
                    <Button Content="📅 Upcoming" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding SelectTabCommand}" CommandParameter="Upcoming" Margin="0,0,4,0"/>
                    <Button Content="✅ Completed" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding SelectTabCommand}" CommandParameter="Completed" Margin="0,0,4,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="+ New Task" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding CreateTaskCommand}" Padding="16,8"/>
            </DockPanel>
        </Border>

        <!-- Filter Toolbar -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         ToolTip="Search tasks by title..." Margin="0,0,12,0" Height="36" VerticalAlignment="Center"/>

                <!-- Project Filter Dropdown -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding ProjectsFilterList}" SelectedItem="{Binding SelectedProjectFilter}" 
                          DisplayMemberPath="Name" Margin="0,0,12,0" Height="36" VerticalAlignment="Center"/>

                <!-- Priority Filter Dropdown -->
                <ComboBox Grid.Column="2" ItemsSource="{Binding PrioritiesFilterList}" SelectedItem="{Binding SelectedPriorityFilter}" 
                          Margin="0,0,12,0" Height="36" VerticalAlignment="Center"/>

                <!-- Sort Order Dropdown -->
                <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptionsList}" SelectedItem="{Binding SelectedSortOption}" 
                          Height="36" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Task List Scroll Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardSubBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Completion Checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}" 
                                          Command="{Binding DataContext.ToggleTaskCompletionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                          CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- Title, Project Badge, & Notes -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="{Binding ProjectColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ProjectName}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding DueDateDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding Priority}" FontSize="11" Foreground="{Binding PriorityColor}" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Pomodoro Badge -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                    <TextBlock Text="🍅 " FontSize="13"/>
                                    <TextBlock Text="{Binding CompletedPomodoros}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="/" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding EstimatedPomodoros}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>

                                <!-- Task Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Focus" Style="{DynamicResource SecondaryButtonStyle}" 
                                            Command="{Binding DataContext.StartTaskFocusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="10,6" FontSize="12" Margin="0,0,6,0"/>
                                    <Button Content="✏️" Style="{DynamicResource SecondaryButtonStyle}" 
                                            Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="8,6" FontSize="12" Margin="0,0,6,0"/>
                                    <Button Content="🗑️" Style="{DynamicResource SecondaryButtonStyle}" 
                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Padding="8,6" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
