<UserControl x:Class="FocusFlow.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="920">

    <Grid>
        <Grid.RowDefinitions>
            <!-- View Tabs Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Search & Filters Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Task Content List -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Tabs Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="8,6" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="📋 All Tasks" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding SelectTabCommand}" CommandParameter="All" Padding="16,8" Margin="0,0,4,0"/>
                    <Button Content="⭐ Today" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding SelectTabCommand}" CommandParameter="Today" Padding="16,8" Margin="0,0,4,0"/>
                    <Button Content="📅 Upcoming" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding SelectTabCommand}" CommandParameter="Upcoming" Padding="16,8" Margin="0,0,4,0"/>
                    <Button Content="✅ Completed" Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding SelectTabCommand}" CommandParameter="Completed" Padding="16,8"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="+ New Task" Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding CreateTaskCommand}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Filter & Search Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search Input -->
                    <ColumnDefinition Width="*"/>
                    <!-- Project Selector -->
                    <ColumnDefinition Width="180"/>
                    <!-- Sort Selector -->
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         ToolTip="Search tasks by title or notes..." Height="36" Margin="0,0,12,0" VerticalAlignment="Center"/>

                <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProjectFilter}"
                          DisplayMemberPath="Name" Margin="0,0,12,0" VerticalAlignment="Center" Height="36"/>

                <ComboBox Grid.Column="2" SelectedValue="{Binding SelectedSortOption}" VerticalAlignment="Center" Height="36">
                    <ComboBoxItem Content="Due Date" IsSelected="True"/>
                    <ComboBoxItem Content="Priority"/>
                    <ComboBoxItem Content="Title"/>
                    <ComboBoxItem Content="Created Date"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Tasks List View -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox completion -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleTaskCompletionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" VerticalAlignment="Top" Margin="0,4,14,0"/>

                                <!-- Details -->
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <!-- Priority Badge -->
                                        <Border Background="{Binding PriorityColor}" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PriorityDisplay}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <!-- Project Badge -->
                                        <Border Background="{Binding ProjectColor}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProjectName}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Notes Preview -->
                                    <TextBlock Text="{Binding Notes}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" 
                                               Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="40"/>

                                    <!-- Subtasks Checklist Preview -->
                                    <ItemsControl ItemsSource="{Binding Subtasks}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <CheckBox IsChecked="{Binding IsCompleted}" 
                                                              Command="{Binding DataContext.ToggleSubtaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Metadata Row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="📅 Due: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding DueDateDisplay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>

                                        <TextBlock Text="🍅 Pomodoros: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding CompletedPomodoros}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding EstimatedPomodoros}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="⚡ Focus" Style="{StaticResource PrimaryButtonStyle}" 
                                            Command="{Binding DataContext.StartTaskFocusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="12,6" FontSize="12" Margin="0,0,6,0"/>

                                    <Button Content="✏️ Edit" Style="{StaticResource SecondaryButtonStyle}" 
                                            Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="10,6" FontSize="12" Margin="0,0,6,0"/>

                                    <Button Content="🗑️" Style="{StaticResource SecondaryButtonStyle}" 
                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="8,6" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
