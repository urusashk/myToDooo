<UserControl x:Class="FocusFlow.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="880" d:DesignWidth="920">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="640" HorizontalAlignment="Left" Margin="0,0,0,40">
            <!-- Appearance & Theme Card -->
            <Border Style="{DynamicResource CardBorderStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; Theme" Style="{DynamicResource Heading2}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Application Theme" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Switch between Dark and Light mode interface dynamically" Style="{DynamicResource SubText}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🌙 Dark Mode" Style="{DynamicResource SecondaryButtonStyle}" 
                                    Command="{Binding ToggleThemeCommand}" CommandParameter="Dark" Padding="14,8" Margin="0,0,8,0"/>
                            <Button Content="☀️ Light Mode" Style="{DynamicResource SecondaryButtonStyle}" 
                                    Command="{Binding ToggleThemeCommand}" CommandParameter="Light" Padding="14,8"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Pomodoro Durations Card -->
            <Border Style="{DynamicResource CardBorderStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Timer Durations" Style="{DynamicResource Heading2}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Focus Session Duration" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Length of focus work interval (minutes)" Style="{DynamicResource SubText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Settings.FocusDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Short Break Duration" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Rest duration between focus sessions (minutes)" Style="{DynamicResource SubText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Settings.ShortBreakMinutes, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Long Break Duration" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Extended break duration after completed cycle (minutes)" Style="{DynamicResource SubText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Settings.LongBreakMinutes, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Long Break Interval" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Number of focus sessions before triggering long break" Style="{DynamicResource SubText}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Settings.LongBreakInterval, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Notifications & Audio Card -->
            <Border Style="{DynamicResource CardBorderStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Notifications &amp; Alerts" Style="{DynamicResource Heading2}" Margin="0,0,0,16"/>

                    <CheckBox IsChecked="{Binding Settings.NotificationsEnabled}" Margin="0,0,0,12">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Enable Windows Desktop Notifications" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Show balloon alerts when focus sessions or breaks complete" Style="{DynamicResource SubText}"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding Settings.SoundEnabled}" Margin="0,0,0,12">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Enable Audio Sounds" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Play sound notifications upon session finish" Style="{DynamicResource SubText}"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding Settings.AutoStartBreaks}" Margin="0,0,0,12">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Auto-start Break Timers" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Automatically start break timer when focus session finishes" Style="{DynamicResource SubText}"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding Settings.AutoStartPomodoros}">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Auto-start Focus Timers" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Automatically start next focus timer when break finishes" Style="{DynamicResource SubText}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- System Tray & Background Behavior Card -->
            <Border Style="{DynamicResource CardBorderStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="System Tray &amp; Background Execution" Style="{DynamicResource Heading2}" Margin="0,0,0,16"/>

                    <CheckBox IsChecked="{Binding Settings.LaunchAtStartup}" Margin="0,0,0,8">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Run in System Tray on Close" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Closing main window minimizes FocusFlow to system tray without exiting process" Style="{DynamicResource SubText}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Keyboard Shortcuts & Reference Card -->
            <Border Style="{DynamicResource CardBorderStyle}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Keyboard Shortcuts &amp; Info" Style="{DynamicResource Heading2}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Spacebar" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                        <TextBlock Text="Start / Pause Active Timer" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Ctrl + N" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                        <TextBlock Text="Create New Task" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Ctrl + Shift + F" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                        <TextBlock Text="Switch to Focus Timer" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom Action Buttons & Padding -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                <Button Content="💾 Save Settings" Style="{DynamicResource PrimaryButtonStyle}" 
                        Command="{Binding SaveSettingsCommand}" Padding="24,10" Margin="0,0,12,0"/>

                <Button Content="Restore Defaults" Style="{DynamicResource SecondaryButtonStyle}" 
                        Command="{Binding ResetDefaultsCommand}" Padding="16,10"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
