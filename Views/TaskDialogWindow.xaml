<Window x:Class="FocusFlow.Views.TaskDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Details" Height="680" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        ResizeMode="NoResize">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <TextBlock Grid.Row="0" x:Name="HeaderTitleText" Text="Task Details" Style="{DynamicResource Heading1}" Margin="0,0,0,20"/>

            <!-- Scrollable Form Controls -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Title -->
                    <TextBlock Text="TASK TITLE *" Style="{DynamicResource SubText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TitleInput" Height="36" Margin="0,0,0,16"/>

                    <!-- Notes -->
                    <TextBlock Text="NOTES / DESCRIPTION" Style="{DynamicResource SubText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NotesInput" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Priority -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="PRIORITY" Style="{DynamicResource SubText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="PriorityCombo" Height="36">
                                <ComboBoxItem Content="Low" Tag="0"/>
                                <ComboBoxItem Content="Medium" Tag="1" IsSelected="True"/>
                                <ComboBoxItem Content="High" Tag="2"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Project -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="PROJECT" Style="{DynamicResource SubText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ProjectCombo" DisplayMemberPath="Name" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Due Date -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="DUE DATE" Style="{DynamicResource SubText}" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DueDatePicker" Height="36"/>
                        </StackPanel>

                        <!-- Estimated Pomodoros -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="ESTIMATED POMODOROS" Style="{DynamicResource SubText}" Margin="0,0,0,6"/>
                            <TextBox x:Name="PomodoroEstimateInput" Text="1" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Recurrence -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="RECURRENCE" Style="{DynamicResource SubText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="RecurrenceCombo" Height="36">
                                <ComboBoxItem Content="None" Tag="0" IsSelected="True"/>
                                <ComboBoxItem Content="Daily" Tag="1"/>
                                <ComboBoxItem Content="Weekly" Tag="2"/>
                                <ComboBoxItem Content="Monthly" Tag="3"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Reminder Date -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="REMINDER DATE" Style="{DynamicResource SubText}" Margin="0,0,0,6"/>
                            <DatePicker x:Name="ReminderDatePicker" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <!-- Subtasks Checklist Section -->
                    <Border Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Subtasks / Checklist" Style="{DynamicResource Heading2}" Margin="0,0,0,12"/>

                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="AddSubtaskBtn" DockPanel.Dock="Right" Content="+ Add" Style="{DynamicResource SecondaryButtonStyle}" Click="AddSubtask_Click" Padding="12,4" Margin="8,0,0,0"/>
                                <TextBox x:Name="NewSubtaskInput" Height="34"/>
                            </DockPanel>

                            <ItemsControl x:Name="SubtasksListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource SecondaryButtonStyle}" Click="DeleteSubtask_Click" Padding="6,2" FontSize="10"/>
                                            <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="Save Task" Style="{DynamicResource PrimaryButtonStyle}" Click="Save_Click" Padding="20,8"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
