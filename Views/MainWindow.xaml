<Window x:Class="FocusFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FocusFlow.ViewModels"
        Title="FocusFlow - Productivity &amp; Pomodoro"
        Height="780" Width="1240"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        WindowStyle="SingleBorderWindow">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="240" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource CardSubBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- App Logo & Branding -->
                <StackPanel DockPanel.Dock="Top" Margin="24,24,24,32" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PrimaryAccentBrush}">
                        <TextBlock Text="⏱️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FocusFlow" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="v1.0 Desktop" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer Quick Focus Widget -->
                <Border DockPanel.Dock="Bottom" Margin="16" Style="{DynamicResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Focus Session" Style="{DynamicResource SubText}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PomodoroViewModel.TimerService.TimeRemainingFormatted}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                        <TextBlock Text="{Binding PomodoroViewModel.TimerService.CurrentSessionType}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>
                        <Button Content="Quick Timer" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding NavigatePomodoroCommand}" Padding="8,6" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Links -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0">
                        <TextBlock Text="MAIN MENU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,12"/>

                        <Button Command="{Binding NavigateDashboardCommand}" Style="{DynamicResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateTasksCommand}" Style="{DynamicResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✅" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Tasks" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateProjectsCommand}" Style="{DynamicResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Projects" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCalendarCommand}" Style="{DynamicResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Calendar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigatePomodoroCommand}" Style="{DynamicResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱️" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Focus Timer" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="ANALYTICS &amp; PREFS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,24,0,12"/>

                        <Button Command="{Binding NavigateReportsCommand}" Style="{DynamicResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Reports" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateSettingsCommand}" Style="{DynamicResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="{DynamicResource BgDarkBrush}">
            <Grid.RowDefinitions>
                <!-- Top Header -->
                <RowDefinition Height="64" />
                <!-- Dynamic View Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveTabName}" Style="{DynamicResource Heading1}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Active Task & Timer Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SQLite Connected • Local Storage" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active View Content Container -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="28"/>
        </Grid>
    </Grid>
</Window>
